rules_version = '2';

/* =========================================================================
   Originate Command — Firestore Security Rules
   Implements section 3.0 (roles and permissions) and 8.1 (enforced at the
   database, not only in the interface) of OM SRS 001.

   Authority comes from custom claims on the token, set server side by the
   setMembershipClaims function and never writable by a client:

     request.auth.token.admin        true for the leadership tier (3.2)
     request.auth.token.departments  { departmentId: rank }
                                     rank 0 is department head, 1 team lead,
                                     higher numbers sit further down (3.4)

   Section 8.1 records the tradeoff: Firestore has no server side joins, so a
   rule reads a person's position from their own claims rather than looking it
   up from the department. Claims refresh on the next login or role change,
   and the audit log makes that window visible.
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }

    function depts() {
      return ('departments' in request.auth.token) ? request.auth.token.departments : {};
    }

    function inDept(deptId) {
      return signedIn() && depts().keys().hasAny([deptId]);
    }

    function rankIn(deptId) { return inDept(deptId) ? depts()[deptId] : 99; }
    function isHead(deptId) { return rankIn(deptId) == 0; }
    function isLead(deptId) { return rankIn(deptId) == 1; }

    /* authority over other people: admin, department head, team lead.
       assignTo() in permissions.js lets anyone take work for themselves,
       which is not authority over anyone else (6.2). */
    function assignsOthers(deptId) {
      return isAdmin() || isHead(deptId) || isLead(deptId);
    }

    function inGroup(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    /* total rather than throwing: indexing a key straight off the map raises
       an evaluation error on any document that lacks it, and an error denies.
       A record written before a field existed would then refuse its own
       assignee a state change. */
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    /* a todo or instruction carries a client and a department before it can
       be posted (5.2) */
    function taggedProperly() {
      return request.resource.data.client is string
          && request.resource.data.client.size() > 0
          && request.resource.data.department is string
          && request.resource.data.department.size() > 0;
    }

    /* ---- users ----------------------------------------------------------
       Own profile and notification preferences, yes. Own role, department or
       status, never: those are granted by whoever has authority, through a
       function (8.2, least privilege). */
    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      /* a whitelist rather than a blacklist of admin, departments and status:
         it is total, and a field added later is closed by default instead of
         being editable until someone remembers to deny it */
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'email', 'phone', 'title', 'avatar', 'prefs']));
    }

    /* ---- departments: data, not schema (4.1); ordering is authority (3.4) */
    match /departments/{deptId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    /* a custom tag is created inline while posting and is available to
       everyone at once (6.4); nothing references a deleted tag */
    match /tags/{tagId} {
      allow read, create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* ---- groups: admin plus department heads, the default in section 13 --- */
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if isAdmin() || depts().values().hasAny([0]);
      allow update: if isAdmin()
                    || resource.data.created_by == request.auth.uid
                    || depts().values().hasAny([0]);
      allow delete: if false;
    }

    /* ---- todos ---------------------------------------------------------- */
    match /todos/{todoId} {
      function canSee() {
        return isAdmin()
            || (resource.data.assignee_type == 'user' && resource.data.assignee == request.auth.uid)
            || (resource.data.assignee_type == 'group' && inGroup(resource.data.assignee))
            || inDept(resource.data.department);
      }

      function assigneeIsSelf() {
        return request.resource.data.assignee_type == 'user'
            && request.resource.data.assignee == request.auth.uid;
      }

      allow read: if canSee();

      allow create: if signedIn()
                    && taggedProperly()
                    && request.resource.data.created_by == request.auth.uid
                    && (assigneeIsSelf() || assignsOthers(request.resource.data.department));

      /* the assignee moves state; only authority hands the work on (6.2) */
      allow update: if isAdmin()
                    || assignsOthers(resource.data.department)
                    || ((resource.data.assignee == request.auth.uid
                         || (resource.data.assignee_type == 'group' && inGroup(resource.data.assignee)))
                        && unchanged('assignee')
                        && unchanged('assignee_type')
                        && unchanged('created_by')
                        && unchanged('department'));

      allow delete: if false;   /* archived, never destroyed (7.0) */

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.author == request.auth.uid;
        allow update, delete: if false;
      }
    }

    /* ---- instructions ----------------------------------------------------
       Posting is open to every authenticated person on purpose (6.3). */
    match /instructions/{noteId} {
      function canSee() {
        return isAdmin()
            || resource.data.author == request.auth.uid
            || inDept(resource.data.department);
      }

      /* the read receipt is the one field any reader may add themselves to */
      function onlyMarkingRead() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
            && request.resource.data.get('read_by', []).hasAll(resource.data.get('read_by', []))
            && request.resource.data.get('read_by', [])
                 .hasOnly(resource.data.get('read_by', []).concat([request.auth.uid]));
      }

      allow read: if canSee();

      allow create: if signedIn()
                    && taggedProperly()
                    && request.resource.data.author == request.auth.uid;

      allow update: if canSee()
                    && (isAdmin()
                        || resource.data.author == request.auth.uid
                        || isHead(resource.data.department)
                        || onlyMarkingRead());

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.author == request.auth.uid;
        allow update, delete: if false;
      }
    }

    /* ---- notifications: written by a function; read and marked by their
       owner and nobody else */
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.user == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
                    && resource.data.user == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    /* ---- audit log: immutable, function written, leadership readable ------ */
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* anything not named above is closed */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
